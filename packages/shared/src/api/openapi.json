          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "result": {}
                },
                "required": ["workerId", "attempt"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["ok"]
                }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Not the lease holder at the current attempt (fencing)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/{id}/bundle": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true,
            "name": "workerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "attempt",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "What the worker renders into /context for this job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "stage": {
                          "type": "string"
                        },
                        "attempt": {
                          "type": "integer"
                        }
                      },
                      "required": ["id", "stage", "attempt"]
                    },
                    "ticket": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "displayId": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        },
                        "acceptanceCriteria": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "modules": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "state": {
                          "type": "string"
                        },
                        "contentVersion": {
                          "type": "integer"
                        },
                        "fixCounts": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer"
                          }
                        },
                        "reviewed": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "displayId",
                        "type",
                        "title",
                        "body",
                        "acceptanceCriteria",
                        "modules",
                        "state",
                        "contentVersion",
                        "fixCounts",
                        "reviewed"
                      ]
                    },
                    "spec": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "displayId": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "displayId",
                        "slug",
                        "title",
                        "body",
                        "type"
                      ]
                    },
                    "repo": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "role": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "defaultBranch": {
                          "type": "string"
                        }
                      },
                      "required": ["id", "role", "url", "defaultBranch"]
                    },
                    "integrationBranch": {
                      "type": ["string", "null"]
                    },
                    "protectedPaths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowedProtectedPaths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "contract": {
                      "type": ["object", "null"],
                      "properties": {
                        "sha": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "repoId": {
                          "type": "integer"
                        }
                      },
                      "required": ["sha", "path", "repoId"]
                    }
                  },
                  "required": [
                    "job",
                    "ticket",
                    "spec",
                    "repo",
                    "integrationBranch",
                    "protectedPaths",
                    "allowedProtectedPaths",
                    "contract"
                  ]
                }
              }
