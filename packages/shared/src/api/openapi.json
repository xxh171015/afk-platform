{
  "openapi": "3.1.0",
  "info": {
    "title": "AFK platform API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/projects": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "defaultAgent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "defaultModel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "contractPath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "protectedPaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "maxItems": 200
                  },
                  "maxConcurrency": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "budgetLimit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "mergePolicy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "limits": {
                    "type": "object",
                    "properties": {
                      "workerSlots": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "projectConcurrency": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "repoConcurrency": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "runIdleSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "runWallclockSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "ticketWallclockSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "specAgentSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "name"]
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/repos": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "defaultBranch": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": ["url", "role"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "role"]
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "The project already has a repo with this role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/specs": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bug", "improvement"]
                  },
                  "slug": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 1000000
                  }
                },
                "required": ["projectId", "type", "slug", "title"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "displayId": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "displayId"]
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "The project already has a spec with this slug",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/specs/{specId}/tickets/import": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "specId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tickets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "displayId": {
                            "type": "string"
                          }
                        },
                        "required": ["key", "id", "displayId"]
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["module-overlap"]
                          },
                          "tickets": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          },
                          "repoId": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": ["type", "tickets", "repoId", "message"]
                      }
                    }
                  },
                  "required": ["tickets", "warnings"]
                }
              }
            }
          },
          "404": {
            "description": "No such spec",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "The spec is not a draft or already has tickets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "422": {
            "description": "Rejected; nothing was written",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["errors"]
                }
              }
            }
          }
        }
      }
    },
    "/specs/{specId}/confirm": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "specId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmed; the spec is running and the tickets that can start are queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "integrationBranches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "repoId": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "branch": {
                            "type": "string"
                          }
                        },
                        "required": ["repoId", "branch"]
                      }
                    },
                    "enqueued": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticketId": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          },
                          "displayId": {
                            "type": "string"
                          },
                          "jobId": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483647
                          }
                        },
                        "required": ["ticketId", "displayId", "jobId"]
                      }
                    }
                  },
                  "required": ["state", "integrationBranches", "enqueued"]
                }
              }
            }
          },
          "404": {
            "description": "No such spec",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "The spec is not a draft, or has no tickets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/claim": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "maxItems": 100
                  }
                },
                "required": ["workerId", "capabilities"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A job leased to the worker, or null when nothing is claimable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "type": ["object", "null"],
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "type": {
                          "type": "string"
                        },
                        "payload": {
                          "type": "object",
                          "additionalProperties": {}
                        },
                        "attempt": {
                          "type": "integer"
                        },
                        "lockKey": {
                          "type": ["string", "null"]
                        },
                        "leaseExpiresAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "payload",
                        "attempt",
                        "lockKey",
                        "leaseExpiresAt"
                      ]
                    }
                  },
                  "required": ["job"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/{id}/heartbeat": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                },
                "required": ["workerId", "attempt"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "leaseExpiresAt": {
                      "type": "string"
                    }
                  },
                  "required": ["leaseExpiresAt"]
                }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Not the lease holder at the current attempt (fencing)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/{id}/pre-push": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                },
                "required": ["workerId", "attempt"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["ok"]
                }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Not the lease holder at the current attempt (fencing)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/{id}/complete": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "result": {}
                },
                "required": ["workerId", "attempt"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["ok"]
                }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Not the lease holder at the current attempt (fencing)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/worker/jobs/{id}/fail": {
      "post": {
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": ["workerId", "attempt", "error"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  },
                  "required": ["ok"]
                }
              }
            }
          },
          "404": {
            "description": "No such job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Not the lease holder at the current attempt (fencing)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
