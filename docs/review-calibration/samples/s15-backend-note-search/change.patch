+/** 解析 GET /orders 的可选 note 查询参数；缺省时不做备注过滤 */
+export function parseNoteFilter(raw: string | null): Result<string | undefined> {
+  if (raw === null) return { ok: true, value: undefined };
+  if (raw === "") return { ok: false, error: "note must not be empty" };
+  if (raw.length > 200) return { ok: false, error: "note must be at most 200 characters" };
+  return { ok: true, value: raw };
+}
