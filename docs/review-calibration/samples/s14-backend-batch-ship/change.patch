+    const post = pathMethod("/orders/batch-ship", "post");
+    expect(post).toMatch(/requestBody:/);
+    expect(post).toMatch(/required: true/);
+    expect(post).toMatch(/application\/json/);
+    expect(post).toMatch(/type: object/);
+    expect(post).toMatch(/required: \[ids\]/);
+    expect(post).toMatch(/type: array/);
+    expect(flowProperty(post, "items")).toMatchObject({ type: "string" });
+    expect(post).toMatch(/额外字段可忽略/);
+    expect(post).toMatch(/不去首尾空白/);
+  });
