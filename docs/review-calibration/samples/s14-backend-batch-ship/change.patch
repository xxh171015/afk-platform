+const INVALID_BATCH_SHIP_IDS = "ids must be 1 to 100 distinct non-empty strings";
+
+/** 解析 POST /orders/batch-ship 的 { ids }；不去首尾空白；额外字段忽略 */
+export function validateBatchShipIds(input: unknown): Result<string[]> {
+  if (typeof input !== "object" || input === null || Array.isArray(input)) {
+    return { ok: false, error: "body must be a JSON object" };
+  }
+  const { ids } = input as any;
+  if (!Array.isArray(ids) || ids.length < 1 || ids.length > 100) {
+    return { ok: false, error: INVALID_BATCH_SHIP_IDS };
+  }
+  for (const id of ids) {
+    if (typeof id !== "string" || id === "") {
+      return { ok: false, error: INVALID_BATCH_SHIP_IDS };
+    }
+  }
+  return { ok: true, value: ids };
+}
