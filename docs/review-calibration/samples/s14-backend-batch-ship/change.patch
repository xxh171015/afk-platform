+    expect(post).toMatch(/minItems: 1/);
+    expect(post).toMatch(/maxItems: 100/);
+    expect(post).toMatch(/uniqueItems: true/);
+    expect(flowProperty(post, "items")).toEqual({ type: "string", minLength: 1 });
+    expect(responseStatuses(post)).toContain("400");
