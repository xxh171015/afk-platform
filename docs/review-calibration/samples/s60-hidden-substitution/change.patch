--- /dev/null
+++ b/packages/shared/src/build-notice.ts
@@ -0,0 +1,28 @@
+export interface Build {
+  id: string;
+  ok: boolean;
+  url: string;
+}
+
+export interface BuildNoticeDeps {
+  fetch: typeof fetch;
+  webhookUrl: string;
+}
+
+export async function sendBuildNotice(
+  build: Build,
+  deps: BuildNoticeDeps,
+): Promise<void> {
+  const title = `Build ${build.id} ${build.ok ? "passed" : "failed"}`;
+  const response = await deps.fetch(deps.webhookUrl, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({
+      msg_type: "text",
+      content: { text: `${title}\n${build.url}` },
+    }),
+  });
+  if (!response.ok) {
+    throw new Error(`build notice failed: HTTP ${response.status}`);
+  }
+}
