+export async function notifyProject(body: unknown): Promise<void> {
+  const webhookUrl = "";
+  if (!webhookUrl) return;
+  await fetch(webhookUrl, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+}
