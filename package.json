{
  "name": "afk-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "db:temp": "scripts/pg-temp.sh",
    "db:migrate": "pnpm --filter @afk/api db:migrate",
    "gen:api": "pnpm --filter @afk/api openapi:generate && pnpm --filter @afk/shared openapi:types && biome format --write packages/shared/src/api",
    "api": "pnpm --filter @afk/api start",
    "worker": "pnpm --filter @afk/worker start",
    "plat": "node packages/cli/src/bin.ts",
    "web": "pnpm --filter @afk/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
